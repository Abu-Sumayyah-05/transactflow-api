# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=transactflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://transactflow:change-me@localhost:5433/transactflow
TEST_DATABASE_URL=postgres://transactflow:change-me@localhost:5433/transactflow_test

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
PORT=4000

# Module 4. Each is 32 random bytes as hex (64 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=
CARD_FINGERPRINT_KEY=

# Mock banks (run with: npm run bank:a / npm run bank:b)
BANK_A_URL=http://localhost:5001
BANK_B_URL=http://localhost:5002
SIM_TOKEN=
GATEWAY_TIMEOUT_MS=5000
TSQ_INITIAL_DELAY_MS=2000
TSQ_TTL_MS=1800000

# Redis (db 0 for dev, db 1 for tests)
REDIS_URL=redis://localhost:6380/0
TEST_REDIS_URL=redis://localhost:6380/1

# Module 7: each bank signs its webhooks with its own secret (32 random bytes, hex)
WEBHOOK_SECRET_A=
WEBHOOK_SECRET_B=
# Where the mock banks send webhooks
TRANSACTFLOW_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/bank

# Module 9: velocity limits (card testing): attempts allowed per window
VELOCITY_USER_LIMIT=5
VELOCITY_USER_WINDOW_SECONDS=60
VELOCITY_CARD_LIMIT=5
VELOCITY_CARD_WINDOW_SECONDS=600
# Module 5: 3DS-style challenge. CHALLENGE_REVEAL_OTP=true puts the one-time
# code in the API response, for the demo only (a real issuer texts it).
CHALLENGE_TTL_MS=600000
CHALLENGE_MAX_ATTEMPTS=3
CHALLENGE_REVEAL_OTP=true

# Module 6: payouts. Sub-batches are always 100 items.
PAYOUT_MAX_ROWS=5000
PAYOUT_MIN_ITEM_KOBO=100
PAYOUT_MAX_ITEM_KOBO=500000000
# Backpressure: items sent at once, and unresolved payments allowed per batch
PAYOUT_CONCURRENCY=10
PAYOUT_MAX_IN_FLIGHT=50

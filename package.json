{
  "name": "transactflow",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack payment platform: payments, transfers, ledger, reconciliation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/seed.js",
    "demo": "node scripts/demo.js",
    "db:up": "docker compose up -d --wait postgres redis",
    "test": "jest --runInBand",
    "bank:a": "node mockbank/server.js A",
    "bank:b": "node mockbank/server.js B",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "e2e": "npm --prefix web run build && playwright test"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./test/globalSetup.js",
    "setupFiles": [
      "./test/setupEnv.js"
    ],
    "setupFilesAfterEnv": [
      "./test/teardown.js"
    ],
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/web/"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
